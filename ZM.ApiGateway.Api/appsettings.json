{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ZM.ApiGateway",
    "Audience": "ZM.Services",
    "SecretKey": "19b29658e1555f3f543116dc9dfb24374a2e9befbea6f82aca166de43663fdf0"
  },
  "Redis": {
    "ConnectionString": "redis:6379",
    "Database": 0,
    "KeyPrefix": "rate-limiter"
  },
  "RateLimiting": {
    "DefaultPolicy": "free",
    "Policies": {
      "free": {
        "Algorithm": "FixedWindow",
        "Limit": 60,
        "Window": "00:01:00"
      },
      "pro": {
        "Algorithm": "SlidingWindow",
        "Limit": 1000,
        "Window": "00:01:00"
      },
      "internal": {
        "Algorithm": "SlidingWindow",
        "Limit": 10000,
        "Window": "00:01:00"
      }
    },
    "ClientPolicies": {
      "123": "free",
      "demo-free-client": "free",
      "demo-pro-client": "pro",
      "demo-internal-client": "internal"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "user",
        "Timeout": "00:00:30",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "user",
        "Timeout": "00:00:30",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "AuthorizationPolicy": "admin",
        "Timeout": "00:00:30",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://zm.users.api:5100"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://zm.orders.api:5200"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://zm.payments.api:5300"
          }
        }
      }
    }
  }
}
